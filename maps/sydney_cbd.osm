  <tag k="memorial" v="plaque"/>
  <tag k="note" v="His excellency the governor of New South Wales &#10;&#10;Lieutenant-General Sir Eric Woodward,&#10;&#10;K.C.M.G., C.B., C.B.E., D.S.O.&#10;&#10;planted this tree on 26th January, 1963."/>
